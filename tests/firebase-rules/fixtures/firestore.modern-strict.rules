// =============================================================================
// [FIXTURE C4.3 - NO DESPLEGABLE EN PRODUCCION]
// Perfil C: MODERN STRICT PROTOCOL - Reglas finales del protocolo C4
// Exige revisión monotónica (+1), metadatos de sincronización íntegros,
// integridad causal estricta de fieldRevisions (preservación de 5 claves,
// no adelanto ficticio sin cambio de datos), prohibición de borrado físico
// y protección contra resurrección.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getFriendshipId(uid1, uid2) {
      return uid1 < uid2 ? (uid1 + '_' + uid2) : (uid2 + '_' + uid1);
    }

    function isFriend(uid1, uid2) {
      let friendshipId = getFriendshipId(uid1, uid2);
      let friendship = get(/databases/$(database)/documents/friendships/$(friendshipId));
      return friendship != null && friendship.data.status == 'ACCEPTED';
    }

    // --- USERS ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- PUBLIC USERS ---
    match /publicUsers/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
                    && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
                    && !('username' in request.resource.data)
                    && !('usernameLowercase' in request.resource.data)
                    && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId)
                    && (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid)
                    && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
                    && request.resource.data.get('username', null) == resource.data.get('username', null)
                    && request.resource.data.get('usernameLowercase', null) == resource.data.get('usernameLowercase', null)
                    && request.resource.data.get('usernameUpdatedAt', null) == resource.data.get('usernameUpdatedAt', null)
                    && request.resource.data.keys().hasOnly(['uid', 'displayName', 'username', 'usernameLowercase', 'photoUrl', 'createdAt', 'updatedAt', 'usernameUpdatedAt']);
      allow delete: if false;
    }

    // --- USERNAMES ---
    match /usernames/{username} {
      allow read, write: if false; // Solo administrable via Cloud Functions
    }

    // --- FRIENDSHIPS ---
    match /friendships/{friendshipId} {
      function isParticipant() {
        return isSignedIn() && (request.auth.uid == resource.data.user1 || request.auth.uid == resource.data.user2);
      }

      function isParticipantForCreate() {
        return isSignedIn() && (request.auth.uid == request.resource.data.user1 || request.auth.uid == request.resource.data.user2);
      }

      allow read: if isParticipant();

      allow create: if isParticipantForCreate()
                    && request.resource.data.requester == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && request.resource.data.user1 != request.resource.data.user2
                    && getFriendshipId(request.resource.data.user1, request.resource.data.user2) == friendshipId
                    && request.resource.data.keys().hasOnly(['user1', 'user2', 'requester', 'status', 'friendshipId']);

      allow update: if isParticipant()
                    && request.resource.data.user1 == resource.data.user1
                    && request.resource.data.user2 == resource.data.user2
                    && request.resource.data.requester == resource.data.requester
                    && request.resource.data.friendshipId == resource.data.friendshipId
                    && resource.data.status == 'PENDING'
                    && request.resource.data.status == 'ACCEPTED'
                    && request.auth.uid != resource.data.requester;

      allow delete: if isParticipant();
    }

    // --- BEERS (PERFIL C: MODERN STRICT PROTOCOL) ---
    match /beers/{beerId} {
      function isBeerOwner() {
        return isSignedIn() && request.auth.uid == resource.data.userId;
      }

      function isValidLastMutationId(id) {
        return id is string && id.size() > 0 && id.size() <= 128;
      }

      function isMutationIdDistinct() {
        return !('lastMutationId' in resource.data) ||
               request.resource.data.lastMutationId != resource.data.lastMutationId;
      }

      // Validacion de fieldRevisions en creacion: todas las 5 unidades deben estar presentes e inicializadas en 1
      function areCreationFieldRevisionsValid(fr) {
        return fr is map &&
          fr.size() == 5 &&
          fr.keys().hasOnly(['TYPE', 'TIMESTAMP', 'LOCATION', 'COMMENT', 'PHOTO']) &&
          fr.TYPE == 1 &&
          fr.TIMESTAMP == 1 &&
          fr.LOCATION == 1 &&
          fr.COMMENT == 1 &&
          fr.PHOTO == 1;
      }

      // Validacion causal estricta de fieldRevisions en actualizacion:
      // - No permite eliminar ninguna clave existente.
      // - Si una unidad logica cambio, su revision debe ser exactamente newRev.
      // - Si una unidad logica NO cambio, debe conservar estrictamente su revision anterior (no adelanto ficticio).
      function isFieldPreservedOrAdvanced(oldFr, newFr, key, changed, newRev) {
        return (key in newFr) &&
          (newFr[key] is int) &&
          (newFr[key] >= 1) &&
          (newFr[key] <= newRev) &&
          (changed ? (newFr[key] == newRev) : (newFr[key] == oldFr.get(key, 1)));
      }

      function areUpdateFieldRevisionsConsistent(oldFr, newFr, newRev) {
        let typeChanged = request.resource.data.get('type', null) != resource.data.get('type', null);
        let timestampChanged = request.resource.data.get('timestamp', null) != resource.data.get('timestamp', null);
        let commentChanged = request.resource.data.get('comment', null) != resource.data.get('comment', null);
        let locationChanged = (request.resource.data.get('latitude', null) != resource.data.get('latitude', null)) ||
                              (request.resource.data.get('longitude', null) != resource.data.get('longitude', null)) ||
                              (request.resource.data.get('locationName', null) != resource.data.get('locationName', null));
        let photoChanged = (request.resource.data.get('remotePhotoUrl', null) != resource.data.get('remotePhotoUrl', null)) ||
                           (request.resource.data.get('photoSource', null) != resource.data.get('photoSource', null));

        return newFr is map &&
          newFr.size() == 5 &&
          newFr.keys().hasOnly(['TYPE', 'TIMESTAMP', 'LOCATION', 'COMMENT', 'PHOTO']) &&
          isFieldPreservedOrAdvanced(oldFr, newFr, 'TYPE', typeChanged, newRev) &&
          isFieldPreservedOrAdvanced(oldFr, newFr, 'TIMESTAMP', timestampChanged, newRev) &&
          isFieldPreservedOrAdvanced(oldFr, newFr, 'LOCATION', locationChanged, newRev) &&
          isFieldPreservedOrAdvanced(oldFr, newFr, 'COMMENT', commentChanged, newRev) &&
          isFieldPreservedOrAdvanced(oldFr, newFr, 'PHOTO', photoChanged, newRev);
      }

      function isStrictCreate() {
        return isSignedIn() &&
          request.auth.uid == request.resource.data.userId &&
          request.resource.data.userId is string &&
          request.resource.data.revision is int &&
          request.resource.data.revision == 1 &&
          'isDeleted' in request.resource.data &&
          request.resource.data.isDeleted is bool &&
          request.resource.data.isDeleted == false &&
          isValidLastMutationId(request.resource.data.get('lastMutationId', null)) &&
          areCreationFieldRevisionsValid(request.resource.data.get('fieldRevisions', null));
      }

      function isStrictUpdate() {
        return isBeerOwner() &&
          // Owner is immutable
          request.resource.data.userId == resource.data.userId &&
          // Monotonic progression: exactly +1
          ('revision' in resource.data) &&
          resource.data.revision is int &&
          ('revision' in request.resource.data) &&
          request.resource.data.revision is int &&
          request.resource.data.revision == resource.data.revision + 1 &&
          // isDeleted must be strictly boolean and cannot resurrect tombstones
          ('isDeleted' in request.resource.data) &&
          request.resource.data.isDeleted is bool &&
          (resource.data.get('isDeleted', false) == true ? request.resource.data.isDeleted == true : true) &&
          // Sync mutation metadata validity
          isValidLastMutationId(request.resource.data.get('lastMutationId', null)) &&
          isMutationIdDistinct() &&
          // Causal integrity of fieldRevisions
          areUpdateFieldRevisionsConsistent(
            resource.data.get('fieldRevisions', {}),
            request.resource.data.get('fieldRevisions', null),
            request.resource.data.revision
          );
      }

      allow read: if isBeerOwner();

      // Creates must start strictly at revision 1 and cannot be already deleted
      allow create: if isStrictCreate();

      // Updates must increment revision strictly by +1, preserve metadata integrity and cannot resurrect tombstones
      allow update: if isStrictUpdate();

      // Physical hard delete is FORBIDDEN for all documents in the modern protocol.
      // Deletions must be performed causally via tombstones (update with isDeleted=true).
      allow delete: if false;
    }

    // --- SHARED BEERS ---
    match /sharedBeers/{beerId} {
      function isBeerOwner() {
        return isSignedIn() && request.auth.uid == resource.data.userId;
      }

      allow read: if isBeerOwner() || (isSignedIn() && isFriend(request.auth.uid, resource.data.userId));

      allow write: if false;
    }

    // --- GROUP INVITATIONS ---
    match /groupInvitations/{invitationId} {
      function getGroup(groupId) {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }

      function isGroupDeleting(groupId) {
        let groupData = getGroup(groupId);
        return groupData != null && groupData.get('deleting', false) == true;
      }

      allow read: if isSignedIn() && (request.auth.uid == resource.data.inviterUid || request.auth.uid == resource.data.inviteeUid);

      allow create: if false;

      allow update: if isSignedIn()
                    && !isGroupDeleting(resource.data.groupId)
                    && (
                      request.auth.uid == resource.data.inviteeUid
                      && request.resource.data.groupId == resource.data.groupId
                      && request.resource.data.groupName == resource.data.groupName
                      && request.resource.data.inviterUid == resource.data.inviterUid
                      && request.resource.data.inviteeUid == resource.data.inviteeUid
                      && resource.data.status == 'PENDING'
                      && (request.resource.data.status == 'ACCEPTED' || request.resource.data.status == 'REJECTED')
                      && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'inviterUid', 'inviteeUid', 'status'])
                    );

      allow delete: if isSignedIn() && (request.auth.uid == resource.data.inviterUid || request.auth.uid == resource.data.inviteeUid);
    }

    // --- GROUPS ---
    match /groups/{groupId} {
      function isGroupAdmin(data) {
        return isSignedIn() && request.auth.uid == data.adminUid;
      }

      function isGroupMember(data) {
        return isSignedIn() && request.auth.uid in data.members;
      }

      allow read: if isGroupMember(resource.data);

      allow create: if isGroupAdmin(request.resource.data)
                    && !('deleting' in request.resource.data)
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 50
                    && request.resource.data.createdAt is number;

      allow update: if resource.data.get('deleting', false) == false
                    && request.resource.data.get('deleting', false) == false
                    && (
                      (
                        isGroupAdmin(resource.data)
                        && request.resource.data.adminUid == resource.data.adminUid
                        && request.resource.data.createdAt == resource.data.createdAt
                        && resource.data.members.hasAll(request.resource.data.members)
                        && (request.auth.uid in request.resource.data.members)
                      )
                      ||
                      (
                        isGroupMember(resource.data)
                        && !isGroupAdmin(resource.data)
                        && request.resource.data.adminUid == resource.data.adminUid
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.members.size() == resource.data.members.size() - 1
                        && !(request.auth.uid in request.resource.data.members)
                        && request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
                      )
                      ||
                      (
                        !isGroupMember(resource.data)
                        && request.resource.data.adminUid == resource.data.adminUid
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.members.size() == resource.data.members.size() + 1
                        && (request.auth.uid in request.resource.data.members)
                        && request.resource.data.members.hasAll(resource.data.members)
                        && getAfter(/databases/$(database)/documents/groupInvitations/$(groupId + '_' + request.auth.uid)).data.status == 'ACCEPTED'
                      )
                    );

      allow delete: if false;

      // --- GROUP COMMENTS ---
      match /comments/{commentId} {
        function getGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isMemberOfGroup() {
          return isSignedIn() && request.auth.uid in getGroup().members;
        }

        function isAdminOfGroup() {
          return isSignedIn() && request.auth.uid == getGroup().adminUid;
        }

        function isGroupDeletingLocally() {
          return getGroup().get('deleting', false) == true;
        }

        allow read: if isMemberOfGroup();

        allow create: if isMemberOfGroup()
                      && !isGroupDeletingLocally()
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.authorName == get(/databases/$(database)/documents/publicUsers/$(request.auth.uid)).data.displayName
                      && request.resource.data.authorUsername == get(/databases/$(database)/documents/publicUsers/$(request.auth.uid)).data.get('username', null)
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 300
                      && request.resource.data.createdAt is number
                      && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'authorUsername', 'text', 'createdAt']);

        allow update: if isMemberOfGroup()
                      && !isGroupDeletingLocally()
                      && resource.data.authorUid == request.auth.uid
                      && request.resource.data.authorUid == resource.data.authorUid
                      && request.resource.data.authorName == resource.data.authorName
                      && request.resource.data.authorUsername == resource.data.authorUsername
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 300
                      && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'authorUsername', 'text', 'createdAt']);

        allow delete: if isMemberOfGroup() && (resource.data.authorUid == request.auth.uid || isAdminOfGroup()) && !isGroupDeletingLocally();
      }
    }
  }
}
