// =============================================================================
// [FIXTURE C4.3 - NO DESPLEGABLE EN PRODUCCION]
// Perfil B: LEGACY COMPATIBILITY STORAGE - Reglas de transición C4.3
// Permite actualización/borrado de fotos legacy no versionadas.
// Protege fotos versionadas con inmutabilidad estricta (no overwrite, no delete).
// =============================================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/beers/{fileName} {
      function isFriend() {
        let id1 = request.auth.uid;
        let id2 = userId;
        let friendshipId = id1 < id2 ? (id1 + '_' + id2) : (id2 + '_' + id1);
        let doc = firestore.get(/databases/(default)/documents/friendships/$(friendshipId));
        return doc != null && doc.data.status == 'ACCEPTED';
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isValidImage() {
        return request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*');
      }

      // Check if photo is versioned (e.g., syncId_mutationId.ext)
      function isVersionedPhoto() {
        return fileName.matches('^[a-zA-Z0-9_-]+_[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp)$');
      }

      allow read: if request.auth != null && (request.auth.uid == userId || isFriend());

      // Versioned photos can only be created if they do NOT already exist (resource == null).
      // Legacy photos can be created normally.
      allow create: if isOwner() && isValidImage() && (isVersionedPhoto() ? resource == null : true);

      // Versioned photos are strictly immutable: cannot be updated or overwritten.
      // Legacy unversioned photos can still be updated or deleted by owner for backwards compatibility.
      allow update: if isOwner() && !isVersionedPhoto() && isValidImage();
      allow delete: if isOwner() && !isVersionedPhoto();
    }
  }
}
